# Sao chep file nay thanh `.env` va dien thong tin cua ban

# Google OAuth Client ID
# Lay tu: https://console.cloud.google.com/ > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE.apps.googleusercontent.com

# Backend API URL — doi thanh IP may chay Spring Boot neu chay nhieu may
# Vi du: VITE_API_BASE_URL=http://192.168.1.100:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
