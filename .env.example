# Sao chép file này thành `.env` và điền thông tin của bạn

# Google OAuth Client ID
# Lấy từ: https://console.cloud.google.com/ > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE.apps.googleusercontent.com

# Backend API URL — đổi thành IP máy chạy Spring Boot nếu chạy nhiều máy
# Ví dụ: VITE_API_BASE_URL=http://192.168.1.100:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
